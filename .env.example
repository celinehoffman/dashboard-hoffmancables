# Copier dans les variables d'environnement Vercel (Settings → Environment Variables)

# Mot de passe qui débloque les données réelles (sans lui, le site reste en démo)
DASHBOARD_PASSWORD=

# Google : compte de service (JSON complet, ou encodé en base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# GA4 : identifiant numérique de la propriété (Admin → Paramètres de la propriété)
GA4_PROPERTY_ID=
# Search Console : "sc-domain:hoffmancables.shop" (propriété domaine) ou "https://www.hoffmancables.shop/"
GSC_SITE_URL=

# Shopify
SHOPIFY_STORE_DOMAIN=xxxx.myshopify.com
# Option A : app du Dev Dashboard (recommandé depuis 2026)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B : jeton d'une ancienne custom app (shpat_…)
SHOPIFY_ADMIN_TOKEN=
